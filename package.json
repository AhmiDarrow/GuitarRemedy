{
  "name": "guitar-remedy",
  "private": true,
  "version": "0.1.0",
  "description": "GuitarRemedy — scales, tabs, 365-day path, song upload breakdown. Hi I'm Ahmi, hope this helps!",
  "author": "Ahmi Darrow <https://github.com/AhmiDarrow>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AhmiDarrow/GuitarRemedy.git"
  },
  "homepage": "https://github.com/AhmiDarrow/GuitarRemedy",
  "bugs": {
    "url": "https://github.com/AhmiDarrow/GuitarRemedy/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.app.json --noEmit && vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm test && npm run test:rust",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "mobile:sync": "npm run build && npx cap sync android",
    "mobile:android": "npx cap open android",
    "mobile:add": "npx cap add android",
    "cap": "cap"
  },
  "dependencies": {
    "@spotify/basic-pitch": "^1.0.1",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tone": "^15.0.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
